# Copy to .env and fill in. NEVER commit .env — it is git-ignored.
# Use Razorpay TEST-mode keys only. This project has no live-mode path.

# Neon: copy both strings from the dashboard's connection panel. The scheme
# is normalised to postgresql+psycopg:// in app/config.py, so paste verbatim.
#   DATABASE_URL          -> the POOLED endpoint (host contains "-pooler").
#                            Used by the app: request handlers are short-lived.
#   DATABASE_URL_UNPOOLED -> the DIRECT endpoint. Used by Alembic, which holds
#                            session state a transaction pooler does not keep.
# Optional: omit DATABASE_URL_UNPOOLED for a plain Postgres with no pooler and
# migrations fall back to DATABASE_URL.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Tests do NOT use the above. They default to a local throwaway Postgres so a
# run can never migrate or truncate the real database; override with
# TEST_DATABASE_URL if you want them elsewhere.
#   docker run -d --name recoup-pg -e POSTGRES_PASSWORD=recoup \
#     -e POSTGRES_USER=recoup -e POSTGRES_DB=recoup -p 55432:5432 postgres:16-alpine

# Razorpay test mode. RAZORPAY_WEBHOOK_SECRET is issued separately from the
# API secret, when you configure the webhook in the dashboard.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# LLM: groq (primary, openai/gpt-oss-120b) or gemini (zero-cost fallback).
# anthropic is also supported but not the default.
LLM_PROVIDER=groq
GROQ_API_KEY=replace_me
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=claude-sonnet-5

# Email. EMAIL_ENABLED=false makes sending a logged no-op so the batch can be
# rehearsed without burning the 100/day free-tier quota.
RESEND_API_KEY=replace_me
EMAIL_FROM=recoup@example.com
EMAIL_ENABLED=false

# Must be false anywhere that could reach live keys. Also gates the
# /api/test-payment routes behind the "Test payment" tab.
DEMO_MODE=true

# Public origin of the React app. Razorpay redirects a payer here
# (<FRONTEND_URL>/pay/return) after a Payment Link is paid. Optional: falls
# back to the first CORS origin, which is the same value in every deployment
# so far.
# FRONTEND_URL=https://recoup.example.com
