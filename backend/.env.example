# Copy to .env and fill in. NEVER commit .env — it is git-ignored.
# Use Razorpay TEST-mode keys only. This project has no live-mode path.

DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# Razorpay test mode. RAZORPAY_WEBHOOK_SECRET is issued separately from the
# API secret, when you configure the webhook in the dashboard.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# LLM: anthropic (primary) or gemini (zero-cost fallback)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.0-flash

# Email. EMAIL_ENABLED=false makes sending a logged no-op so the batch can be
# rehearsed without burning the 100/day free-tier quota.
RESEND_API_KEY=replace_me
EMAIL_FROM=recoup@example.com
EMAIL_ENABLED=false

# Must be false anywhere that could reach live keys.
DEMO_MODE=true
